# ── StudyBuddy Backend — environment template ─────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Google Gemini API key — REQUIRED for AI flashcard generation.
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Secret used to sign JWT auth tokens (HS256).
# Optional locally — a dev fallback is built in — but set a strong random
# value in production, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Database connection string.
# For Supabase PostgreSQL:
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# For local SQLite (fallback — the db file and tables are auto-created on first run):
# DATABASE_URL=sqlite:///./studybuddy.db

# Comma-separated list of browser origins allowed to call this API directly (CORS).
# Local dev origins (http://localhost:3000, http://127.0.0.1:3000) are always allowed.
# In production (Vercel frontend -> Railway backend, direct browser calls), add the
# frontend's origin(s), e.g.:
# CORS_ORIGINS=https://studybuddy.vercel.app
# Use * to allow any origin (only if you accept that — the API is JWT-protected).
CORS_ORIGINS=
