# Local dev / single Docker container: leave NEXT_PUBLIC_BACKEND_URL empty — API
# calls stay same-origin under /api and next.config.js proxies them to the
# FastAPI backend on localhost:8000.

# Vercel + Railway production: NEXT_PUBLIC_BACKEND_URL is read at BUILD time and
# inlined into the client bundle, so set it on Vercel to the deployed Railway
# backend's public URL (no trailing slash), e.g.:
# NEXT_PUBLIC_BACKEND_URL=https://studybuddy-production.up.railway.app
# The browser then calls the backend directly — the backend must allow this
# origin via its CORS_ORIGINS env var.
NEXT_PUBLIC_BACKEND_URL=
